# ===================================================================================
#  IPTV Engine Pro · TODA la configuración sale de variables de entorno (cero vendor lock-in)
#  Migrar de la capa gratis a un VPS = cambiar ESTOS valores. El código no cambia.
# ===================================================================================

# ---- Base de datos / API (Supabase Free hoy; Supabase self-hosted o Postgres+PostgREST en tu VPS mañana)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=            # SECRETA (solo Worker y motor; jamás en el navegador)
SUPABASE_JWT_SECRET=             # solo si tu instancia usa HS256; si no, se usa JWKS

# ---- API pública (Cloudflare Workers Free hoy; Node/Docker/Deno en tu VPS mañana, mismo código Hono)
SIGNING_SECRET=                  # texto largo aleatorio
ALLOWED_ORIGINS=http://localhost:5173
PLAYER_PROXY_ENABLED=true
BILLING_WEBHOOK_SECRET=          # solo cuando actives cobros (Lemon Squeezy / Paddle)

# ---- Motor (Docker en tu PC / VPS / GitHub Actions)
ENGINE_ID=motor-1
VANTAGE=local-do                 # local-* = cualquier fallo cuenta · github / vps-* = solo 404/410
WORKERS=32
TIMEOUT=5
SCHEDULE_EVERY_MIN=30
# Agente BYON (en el PC de un usuario Pro; sin service_role):
AGENT_TOKEN=
PROXY_TEST_URL=https://ipinfo.io/json   # a dónde se conecta el motor para probar tus proxies (devuelve IP y país)
# Avisos
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Panel (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WORKER_URL=https://play.TUDOMINIO.com

# --- Guía de programación (EPG) ---
EPG_STORAGE=file                 # file (VPS/disco) | s3 (Cloudflare R2, Backblaze B2, MinIO...)
EPG_DIR=/data/epg                # solo si EPG_STORAGE=file
S3_ENDPOINT=                     # solo si EPG_STORAGE=s3
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
EPG_DAYS=3                       # días de programación por delante
EPG_EVERY_HOURS=12               # cada cuánto se rearma la guía
EPG_MAX_MB=200                   # tope de tamaño por fuente descargada
EPG_PUBLIC_BASE=                 # Worker: URL pública del bucket (alternativa al binding R2)

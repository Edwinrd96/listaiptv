SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=pega-aqui-la-service-role-key     # SECRETA: nunca en el navegador ni en GitHub
ENGINE_ID=motor-casa
VANTAGE=local-do             # local-do = cualquier fallo cuenta como strike · github/vps-eeuu = solo 404/410
WORKERS=32
TIMEOUT=5                    # segundos por sondeo (total)
CHANNEL_BUDGET=20            # segundos máx. por fuente incluyendo la rotación de User-Agents
POLL_SECONDS=15
SCHEDULE_EVERY_MIN=30        # 0 = solo trabajos del botón
# Avisos opcionales
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Modo agente (BYON): para ejecutar `python -m iptv_engine agent` en tu PC sin dar la service_role
SUPABASE_ANON_KEY=
AGENT_TOKEN=
PROXY_TEST_URL=https://ipinfo.io/json   # a dónde se conecta el motor para probar tus proxies (devuelve IP y país)

# --- Guía de programación (EPG) ---
EPG_STORAGE=file
EPG_DIR=/data/epg
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
EPG_DAYS=3
EPG_EVERY_HOURS=12
EPG_MAX_MB=200
